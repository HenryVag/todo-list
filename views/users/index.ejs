<h2>Users Table</h2>
<table class="table">
  <thead>
    <tr>
      <th>Name</th>
    </tr>
  </thead>
  <tbody>
    <% users.forEach(user => { %>
    <tr>
      <td>
        <a href="<%= `/users/${user._id}`%>">
        <%= user.username %></td>
     
      
      
    </tr>
    <% }); %>
  </tbody>
</table>