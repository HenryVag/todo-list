<div class="data-form">
  <form
    class="form-signin"
    action="<%=`/tasks/${task._id}/update?_method=PUT`%>"
    method="POST"
  >
    <h2 class="form-signin-heading">Edit task:</h2>
    <label for="inputTitle">Title</label>
    <input
      type="text"
      name="title"
      id="inputTitle"
      class="form-control"
      value="<%= task.title %>"
      placeholder="Title"
      autofocus
      required
    />
    <label for="inputDescription">Description</label>
    <input
      type="text"
      name="description"
      id="inputDescription"
      class="form-control"
      value="<%= task.description %>"
      placeholder="Description"
      required
    />
    <br /><button class="btn btn-lg btn-primary btn-block" type="submit">
      Save
    </button>
  </form>
</div>
