<div class="data-form">
  <form class="form-signin" action="/tasks/create" method="POST">
    <h2 class="form-signin-heading">Create a new task:</h2>
    <label for="inputTitle">Title</label>
    <input
      type="text"
      name="title"
      id="inputTitle"
      class="form-control"
      placeholder="Title"
      autofocus
      required
    />
    <label for="inputDescription">Description</label>
    <input
      type="text"
      name="description"
      id="inputDescription"
      class="form-control"
      placeholder="Description"
      required
    />
    <br /><button class="btn btn-lg btn-primary btn-block" type="submit">
      Create
    </button>
  </form>
</div>
